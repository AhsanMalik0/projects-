# App
APP_ENV=development
SECRET_KEY=change-me-to-random-32-bytes
API_KEY_SALT=change-me-to-random-salt

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/voiceagent
REDIS_URL=redis://localhost:6379/0

# LLM — Gemini only (get free key at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Leave these blank — not needed when using Gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# STT — set to gemini (uses same GEMINI_API_KEY above)
# Options: gemini | deepgram | whisper
STT_PROVIDER=gemini
DEEPGRAM_API_KEY=

# TTS — set to gemini (uses same GEMINI_API_KEY above)
# Options: gemini | elevenlabs | openai
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=

# Vector DB (for RAG / knowledge base) — embeddings use Gemini (768-dim)
# Use qdrant (self-hosted, free) or pinecone (cloud)
VECTOR_DB_PROVIDER=qdrant
PINECONE_API_KEY=
PINECONE_INDEX_NAME=voice-agent-kb
PINECONE_ENVIRONMENT=us-east-1-aws

# Observability (optional)
SENTRY_DSN=

# CORS (comma-separated origins or * for all)
CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Upload Limits
MAX_UPLOAD_SIZE_MB=20

# Telephony — Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
